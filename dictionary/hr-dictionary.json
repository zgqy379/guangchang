{
  "$schema": "./dictionary.schema.json",
  "dictionary": "hr",
  "version": "1.1.0",
  "description": "HR 侧参数空间化词典（project.md 5.1 的机器可读版）。词条增删改后 HR 面板表单自动同步。",
  "entries": [
    {
      "id": "annual_base_salary",
      "label": "基础年薪（12 薪部分）",
      "side": "hr",
      "priority": "P0",
      "implementation": "implemented",
      "perception": "膝盖高 vs 一人高无需解释",
      "input": {
        "type": "slider",
        "min": 60000,
        "max": 1000000,
        "step": 10000,
        "default": 150000,
        "unit": "元",
        "format": "wan-yuan",
        "bind": "annualBaseSalary"
      },
      "mapping": {
        "type": "moneyMountain",
        "params": {
          "billDenominationYuan": 100,
          "billsPerStack": 50,
          "billFootprint": [
            0.155,
            0.077
          ],
          "stackHeight": 0.005,
          "layerRole": "base"
        }
      },
      "antiGaming": [
        {
          "rule": "山体分层强制可见：base/绩效/期权三色分垒，禁止渲染成混合山",
          "params": {
            "layerColors": {
              "base": "#c23a2b",
              "increment": "#d98e32",
              "equity": "#8fb4d9"
            }
          }
        },
        {
          "rule": "低区间（<30 万）附加等身刻度人偶，解决低端分辨率",
          "params": {
            "rulerThreshold": 300000
          }
        }
      ]
    },
    {
      "id": "salary_structure",
      "label": "薪资结构",
      "side": "hr",
      "priority": "P0",
      "implementation": "implemented",
      "perception": "多出来的钱换了个颜色，一目了然",
      "input": {
        "type": "select",
        "options": [
          {
            "value": 12,
            "label": "12 薪"
          },
          {
            "value": 13,
            "label": "13 薪"
          },
          {
            "value": 14,
            "label": "14 薪"
          },
          {
            "value": 16,
            "label": "16 薪"
          }
        ],
        "default": 12,
        "bind": "salaryStructure"
      },
      "mapping": {
        "type": "moneyMountain",
        "params": {
          "incrementLayerRatio": "(months - 12) / 12",
          "layerRole": "increment",
          "color": "#d98e32"
        }
      },
      "antiGaming": [
        {
          "rule": "用总包混淆 base：增量层必须异色堆叠在 base 层之上，不允许并入 base 色"
        }
      ]
    },
    {
      "id": "social_insurance_base_ratio",
      "label": "五险一金缴费基数",
      "side": "hr",
      "priority": "P0",
      "implementation": "implemented",
      "perception": "到手前损耗的真实差距",
      "input": {
        "type": "select",
        "options": [
          {
            "value": "full",
            "label": "全额缴纳"
          },
          {
            "value": "0.8",
            "label": "80% 基数"
          },
          {
            "value": "0.6",
            "label": "60% 基数"
          },
          {
            "value": "min",
            "label": "最低基数"
          }
        ],
        "default": "full",
        "bind": "socialInsuranceBaseRatio"
      },
      "mapping": {
        "type": "moneyMountain",
        "params": {
          "carvedZone": true,
          "carveScale": {
            "full": 0.1,
            "0.8": 0.4,
            "0.6": 0.7,
            "min": 1.0
          },
          "carvedLabel": "被切走的部分（按基数比例缩放）"
        }
      },
      "antiGaming": [
        {
          "rule": "切口大小按基数比例映射，全额=完整小切口，60%=明显大切口"
        }
      ]
    },
    {
      "id": "equity_value",
      "label": "期权/奖金（画饼区）",
      "side": "hr",
      "priority": "P0",
      "implementation": "implemented",
      "perception": "可能兑现可能归零",
      "input": {
        "type": "slider",
        "min": 0,
        "max": 5000000,
        "step": 50000,
        "default": 0,
        "unit": "元",
        "format": "wan-yuan",
        "bind": "equityValue"
      },
      "mapping": {
        "type": "schrodingerBills",
        "params": {
          "billDenominationYuan": 100,
          "billsPerStack": 50,
          "floatHeight": [
            0.4,
            1.2
          ],
          "color": "#8fb4d9"
        }
      },
      "antiGaming": [
        {
          "rule": "透明度上限 45%：半透明渲染，视觉体积天然打折",
          "params": {
            "maxOpacity": 0.45
          }
        },
        {
          "rule": "缩放系数 0.5：同等面额只渲染一半体积",
          "params": {
            "scaleFactor": 0.5
          }
        },
        {
          "rule": "期权视觉体积上限 = base 山体积 × 2，超出部分不渲染并挂标签「按规则隐藏」",
          "params": {
            "capRatioOfBase": 2
          }
        }
      ]
    },
    {
      "id": "offwork_time",
      "label": "实际下班时间",
      "side": "hr",
      "priority": "P0",
      "implementation": "implemented",
      "perception": "准点走的温度 / 无声的强度陈述",
      "input": {
        "type": "slider",
        "min": 17,
        "max": 26,
        "step": 0.5,
        "default": 18,
        "format": "clock-hour",
        "bind": "offworkTime"
      },
      "mapping": {
        "type": "skyClock",
        "params": {
          "sunsetStart": 18,
          "nightStart": 20,
          "moonRiseAfter": 20,
          "maxNightSky": 26
        }
      },
      "antiGaming": [
        {
          "rule": "「弹性」不可作为自由文本声明：必须绑定 flexible_hours 开关（时间环可拖动验证）"
        }
      ]
    },
    {
      "id": "flexible_hours",
      "label": "弹性工作制",
      "side": "hr",
      "priority": "P1",
      "implementation": "planned",
      "perception": "弹不弹性，拖一下就知道",
      "input": {
        "type": "toggle",
        "default": false
      },
      "mapping": {
        "type": "timeRing",
        "params": {
          "draggable": true
        }
      }
    },
    {
      "id": "weekend_policy",
      "label": "休息制度",
      "side": "hr",
      "priority": "P1",
      "implementation": "planned",
      "perception": "制度透明化",
      "input": {
        "type": "select",
        "options": [
          {
            "value": "double",
            "label": "双休"
          },
          {
            "value": "alternate",
            "label": "大小周"
          },
          {
            "value": "single",
            "label": "单休"
          }
        ],
        "default": "double"
      },
      "mapping": {
        "type": "calendarWall",
        "params": {}
      }
    },
    {
      "id": "overtime_paid",
      "label": "加班补偿",
      "side": "hr",
      "priority": "P1",
      "implementation": "planned",
      "perception": "最重要的隐性参数之一",
      "input": {
        "type": "select",
        "options": [
          {
            "value": "paid",
            "label": "有偿/调休"
          },
          {
            "value": "free",
            "label": "无偿"
          }
        ],
        "default": "paid"
      },
      "mapping": {
        "type": "noticeBoardLight",
        "params": {
          "green": "paid",
          "red": "free"
        }
      }
    },
    {
      "id": "work_mode",
      "label": "办公模式",
      "side": "hr",
      "priority": "P0",
      "implementation": "planned",
      "perception": "远程公司的「办公室」就是没有办公室——这本身就是最大的福利可视化",
      "input": {
        "type": "select",
        "options": [
          {
            "value": "onsite",
            "label": "坐班"
          },
          {
            "value": "hybrid",
            "label": "混合"
          },
          {
            "value": "remote",
            "label": "远程"
          }
        ],
        "default": "onsite"
      },
      "mapping": {
        "type": "remoteCamp",
        "params": {
          "onsite": "完整办公楼",
          "hybrid": "主空间 + 卫星营地",
          "remote": "分布式营地：每人自带小星球工位，主空间只保留参数景观"
        }
      }
    },
    {
      "id": "funding_stage",
      "label": "融资阶段",
      "side": "hr",
      "priority": "P1",
      "implementation": "planned",
      "perception": "早期风险 / 阶段判断 / 稳定暗示",
      "input": {
        "type": "select",
        "options": [
          {
            "value": "angel",
            "label": "天使轮"
          },
          {
            "value": "a",
            "label": "A 轮"
          },
          {
            "value": "b",
            "label": "B 轮"
          },
          {
            "value": "c",
            "label": "C 轮"
          },
          {
            "value": "d",
            "label": "D 轮"
          },
          {
            "value": "listed",
            "label": "已上市"
          }
        ],
        "default": "a"
      },
      "mapping": {
        "type": "buildingStage",
        "params": {
          "angel": "脚手架毛坯",
          "d": "封顶未装修",
          "listed": "精装大堂"
        }
      }
    },
    {
      "id": "team_size",
      "label": "团队规模",
      "side": "hr",
      "priority": "P1",
      "implementation": "planned",
      "perception": "人多不多一眼可见",
      "input": {
        "type": "slider",
        "min": 10,
        "max": 100000,
        "step": 10,
        "default": 100,
        "unit": "人",
        "format": "plain"
      },
      "mapping": {
        "type": "npcDensity",
        "params": {
          "logScale": true
        }
      }
    },
    {
      "id": "benefits",
      "label": "福利（餐补/房补/健身房）",
      "side": "hr",
      "priority": "P1",
      "implementation": "planned",
      "perception": "福利好感知",
      "input": {
        "type": "toggle",
        "default": false
      },
      "mapping": {
        "type": "lifeZone",
        "params": {
          "zone": "空间边缘生活区"
        }
      },
      "antiGaming": [
        {
          "rule": "福利渲染在空间边缘「生活区」，与核心三景观物理隔离，防止福利淹没薪酬主线"
        }
      ]
    },
    {
      "id": "office_location",
      "label": "办公地址",
      "side": "hr",
      "priority": "P1",
      "implementation": "planned",
      "perception": "通勤体感",
      "input": {
        "type": "select",
        "options": [
          {
            "value": "demo-city",
            "label": "示例城市（Demo）"
          }
        ],
        "default": "demo-city"
      },
      "mapping": {
        "type": "commuteMap",
        "params": {
          "map": "mapbox-fill-extrusion"
        }
      }
    },
    {
      "id": "non_compete",
      "label": "竞业协议",
      "side": "hr",
      "priority": "P1",
      "implementation": "planned",
      "perception": "离开的成本",
      "input": {
        "type": "select",
        "options": [
          {
            "value": "none",
            "label": "无"
          },
          {
            "value": "6m",
            "label": "6 个月"
          },
          {
            "value": "1y",
            "label": "1 年"
          },
          {
            "value": "2y",
            "label": "2 年"
          }
        ],
        "default": "none"
      },
      "mapping": {
        "type": "exitGate",
        "params": {
          "none": "开放出口",
          "default": "旋转门",
          "2y": "铁栅栏"
        }
      }
    },
    {
      "id": "team_age_vibe",
      "label": "团队画风",
      "side": "hr",
      "priority": "P1",
      "implementation": "planned",
      "perception": "半玩笑半真实",
      "input": {
        "type": "select",
        "options": [
          {
            "value": "cyber",
            "label": "赛博霓虹（年轻）"
          },
          {
            "value": "wood",
            "label": "原木商务（沉稳）"
          }
        ],
        "default": "cyber"
      },
      "mapping": {
        "type": "nameplate",
        "params": {
          "affects": "空间整体画风"
        }
      }
    }
  ]
}